    "import numpy as np\n",
    "import astropy.units as u"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "addf9506",
   "metadata": {},
   "outputs": [],
   "source": [
    "def Lacc(L_pa):\n",
    "    return 10 ** (1.42* np.log10(L_pa/u.L_sun) + 3.33 )\n",
    "\n",
    "\n",
    "def L_pa(Weq, F_cont):\n",
    "    d = 200000*u.lyr\n",
    "    return (Weq * F_cont) * 4 * np.pi* d**2\n",
    "\n",
    "\n",
    "\n"
   ]
